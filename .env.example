# ── LLM ────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 메인 모델: 도구 호출 계획·결과 평가·반경 확대 판단·최종 응답 생성
# (gpt-5 계열은 temperature를 받지 않음)
ER_MAIN_MODEL=gpt-5-mini
ER_MAIN_REASONING_EFFORT=low
ER_MAIN_MAX_OUTPUT_TOKENS=1500

# 분류 모델: 위급도 사전 분류, 프롬프트 인젝션 판별
ER_CLASSIFIER_MODEL=gpt-4o-mini
ER_CLASSIFIER_TEMPERATURE=0
ER_CLASSIFIER_MAX_TOKENS=200

# ── 공공데이터포털 E-Gen 응급의료정보 API ───────────────
EGEN_SERVICE_KEY=your-egen-service-key
EGEN_BASE_URL=http://apis.data.go.kr/B552657/ErmctInfoInqireService
EGEN_DAILY_CALL_LIMIT=1000   # 개발계정 일 한도, 초과 전 경고

# ── 카카오 로컬 API (주소/장소 검색) ────────────────────
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_BASE_URL=https://dapi.kakao.com

# ── 외부 호출 정책 ──────────────────────────────────────
ER_REQUEST_TIMEOUT=5         # 타임아웃(초)
ER_MAX_RETRIES=2             # 재시도 횟수 (타임아웃·5xx·429)
ER_RETRY_BACKOFF=1           # 재시도 백오프(초)
ER_BED_CACHE_TTL=60          # 병상 조회 캐시 유효시간(초)
ER_STALE_MINUTES=15          # 이 시간 넘은 병상 정보는 '갱신 지연' 표시

# ── 탐색 정책 ───────────────────────────────────────────
ER_RADIUS_STEPS=5,10,20,30   # 반경 확대 단계(km), 확대 최대 3회
ER_RADIUS_WALK=3             # 이동수단별 시작 반경(km)
ER_RADIUS_CAR=5
ER_RADIUS_TRANSIT=5
ER_MAX_CANDIDATES=3          # 최종 안내 후보 수

# ── 에이전트 실행 ───────────────────────────────────────
ER_MODEL_CALL_LIMIT=10       # 모델 호출 상한 (ModelCallLimitMiddleware)
ER_DEFAULT_TRANSPORT=car     # walk | car | transit
ER_DEMO_MODE=false           # true면 녹화 fixture 기반 데모 모드
ER_LOG_LEVEL=INFO
# 대화 상태는 InMemorySaver(thread_id=user_id), 프로필은 InMemoryStore를 쓴다.
# 별도 DB 설정은 없다.
